# The app calls the API relative to its own origin (/api, /sanctum); the Vite dev server proxies those paths.
# Where the dev server proxies /api and /sanctum to (default http://localhost:8000).
API_PROXY_TARGET=http://localhost:8000

# Optional: override the API base URL the app calls (default /api). Leave unset to go through the proxy.
# VITE_API_URL=/api
